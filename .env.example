# Variables que consume docker-compose.yml. Copiar a .env (gitignored) y
# rellenar.
#
#   cp .env.example .env && chmod 600 .env
#
# Genera cada secreto con:  openssl rand -base64 48
#
# Las de PostgreSQL y API son obligatorias: el stack no arranca sin ellas. Las
# del bot de WhatsApp (de "--- Bot" en adelante) son opcionales y solo hacen
# falta en el servidor que corre el asistente 24/7; en un portátil que solo
# levanta la base con `make dev-db` se dejan en blanco o se borran.

# --- PostgreSQL ---
# Si ya existe el volumen `pgdata`, POSTGRES_PASSWORD tiene que seguir siendo el
# que se usó al crearlo: Postgres solo aplica esta variable en la inicialización.
# Para rotarla de verdad: ALTER USER <user> WITH PASSWORD '<nueva>';
POSTGRES_USER=cryotech
POSTGRES_PASSWORD=
POSTGRES_DB=cryotech

# --- API ---
# Mínimo 32 caracteres cada uno. El arranque los valida y falla si son cortos o
# si son los literales de ejemplo.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Origen exacto del frontend. Sin comodines: la API responde con credentials.
CORS_ORIGIN=http://localhost:3002
# Alta pública de cuentas. Sin valor, se decide por NODE_ENV: cerrada en
# producción, abierta fuera de ella. Es la única ruta que crea usuarios y
# empresas sin credenciales previas, así que en una API expuesta a internet
# debe estar en 'false'.
REGISTRATION_ENABLED=

# --- pgAdmin (solo con --profile dev) ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ==========================================================================
# Bot del asistente — solo el servidor que lo ejecuta necesita esta parte.
# ==========================================================================
#
# Dos canales, el mismo asistente detrás. Configurar uno solo es normal: cada
# transporte se queda inactivo si le faltan sus variables, sin romper al otro.
#
# Ojo: dejar una de estas en blanco no es lo mismo que borrarla. Compose pasa
# la variable solo si tiene valor, así que una línea vacía equivale a no
# ponerla. Lo que sí rompe el arranque es un BUFFER_PULL_TOKEN de menos de 32
# caracteres.

# --- Cola de entrada (Worker de Cloudflare) ---
# La API tira de esta cola; no recibe nada. Sin BUFFER_URL ni BUFFER_PULL_TOKEN
# el poller arranca, avisa de que se queda inactivo, y el bot no responde nunca.
BUFFER_URL=
# El mismo valor que `wrangler secret put PULL_TOKEN`. Mínimo 32 caracteres.
BUFFER_PULL_TOKEN=
# Cada consulta es una petición contra el Worker, y el tier gratis son 100.000
# al día: a 2s son ~43.000, a 5s son ~17.000 y el bot se sigue sintiendo
# instantáneo.
BUFFER_POLL_SECONDS=5

# --- Meta / WhatsApp Cloud API ---
# Token de usuario de sistema (permanente). El token temporal del panel dura
# 24h y deja el bot mudo cada noche.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_GRAPH_VERSION=v21.0

# --- Telegram ---
# No pide verificación de negocio, que es lo que mantiene apagados los
# formularios de WhatsApp. El token lo da @BotFather.
TELEGRAM_BOT_TOKEN=
# Lo que autentica el webhook. Genéralo con `openssl rand -hex 32`: Telegram
# solo acepta A-Z a-z 0-9 _ - en este campo, así que base64 no sirve. Mínimo 32
# caracteres o la API no arranca. Vacío = el endpoint responde 403 a todo.
TELEGRAM_WEBHOOK_SECRET=
# Se registra con `scripts/telegram-set-webhook.sh`; aquí solo para tenerla a
# mano. Debe ser HTTPS y pública.
#   TELEGRAM_WEBHOOK_URL=https://cryotech-api.onrender.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# --- Asistente ---
# Empresa sobre la que opera el bot y quién puede hablarle. Los teléfonos van
# separados por coma y en formato internacional sin '+'; los ids de Telegram
# son numéricos y los da @userinfobot.
ASSISTANT_COMPANY_ID=
ASSISTANT_ALLOWED_PHONES=
ASSISTANT_ALLOWED_TELEGRAM_IDS=
ASSISTANT_TIMEZONE=America/Caracas
ASSISTANT_DRAFT_TTL_MINUTES=60
ASSISTANT_FLOW_TTL_MINUTES=60
# 'true' sustituye a Claude por un lector de fixtures: solo para pruebas.
ASSISTANT_FAKE_AI=false

# --- Lectura de comprobantes (OCR + Claude) ---
# Sin ANTHROPIC_API_KEY el respaldo de lectura queda desactivado y solo actúa
# Tesseract; el bot sigue funcionando para todo lo demás.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=
OCR_LANG=spa
OCR_MIN_CONFIDENCE=
OCR_FALLBACK_ENABLED=true

# --- Tasa del BCV ---
# En el servidor apunta al proxy del Worker, NO a bcv.org.ve: Node no puede
# verificar la cadena de certificado del BCV, y la bandera que lo permitía
# (BCV_ALLOW_INSECURE_TLS) está prohibida con NODE_ENV=production.
#   BCV_URL=https://<tu-worker>.workers.dev/bcv
BCV_URL=
# El mismo PULL_TOKEN: el proxy exige el token para que no se lo coman otros.
BCV_PROXY_TOKEN=
BCV_TIMEOUT_MS=10000
# Última red si el scrape falla y no hay ninguna tasa en caché. Se usa solo en
# ese caso; nunca sustituye a una tasa real.
EXCHANGE_RATE_FALLBACK=

# --- Formularios nativos de WhatsApp (Flows) ---
WHATSAPP_FLOWS_ENABLED=false
WHATSAPP_FLOW_IDS=
WHATSAPP_FLOWS_DRAFT=false
